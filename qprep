def eprint(*args, **kwargs):
    print(*args, file=sys.stderr, **kwargs)


def parse_orca_input(content: str) -> dict:
    """Parses ORCA input file content to extract nprocs."""
    nprocs = None

    pal_match = re.search(r"^\s*!\s*.*PAL(\d+)", content, re.IGNORECASE | re.MULTILINE)
    nprocs_match = re.search(
        r"^\s*%pal\s*\n\s*nprocs\s+(\d+)", content, re.IGNORECASE | re.MULTILINE
    )
    nprocs_block_match = re.search(r"nprocs\s+(\d+)", content, re.IGNORECASE)

    if pal_match:
        nprocs = int(pal_match.group(1))
    elif nprocs_match:
        nprocs = int(nprocs_match.group(1))
    elif nprocs_block_match:
        nprocs = int(nprocs_block_match.group(1))

    return {"nprocs": nprocs}


def rewrite_nprocs_in_content(content: str, new_nprocs: int) -> str:
    """Rewrite the nprocs value in an ORCA input string."""
    if re.search(r"\bPAL\d+\b", content, re.IGNORECASE):
        return re.sub(r"\bPAL\d+\b", f"PAL{new_nprocs}", content, flags=re.IGNORECASE)
    if re.search(r"\bnprocs\s+\d+", content, re.IGNORECASE):
        return re.sub(r"(\bnprocs\s+)\d+", rf"\g<1>{new_nprocs}", content, flags=re.IGNORECASE)
    return content


def extract_orca_tags(content: str) -> list[str]:
    """Derive recli tags from the ORCA input keywords."""
    tags = []

    kw_line = " ".join(
        line.strip().lower()
        for line in content.splitlines()
        if line.strip().startswith("!")
    )

    # Job type — specific types before generic ones
    if "neb-ts" in kw_line:
        tags.append("neb-ts")
    elif "neb" in kw_line:
        tags.append("neb")
    elif "optts" in kw_line:
        tags.append("optts")
    elif "irc" in kw_line:
        tags.append("irc")
    elif "optfreq" in kw_line or ("opt" in kw_line and ("freq" in kw_line or "numfreq" in kw_line)):
        tags.append("optfreq")
    elif "opt" in kw_line:
        if re.search(r"^\s*scan\b", content, re.IGNORECASE | re.MULTILINE):
            tags.append("scan")
        else:
            tags.append("opt")
    elif "numfreq" in kw_line or "freq" in kw_line:
        tags.append("freq")
    elif "nmr" in kw_line:
        tags.append("nmr")
    elif "eda" in kw_line:
        tags.append("eda")
    elif "nbo" in kw_line:
        tags.append("nbo")
    elif "goat" in kw_line:
        tags.append("goat")
    else:
        tags.append("sp")

    # Method — only tag non-DFT methods worth distinguishing
    if "xtb" in kw_line:
        tags.append("xtb")
    elif "dlpno" in kw_line:
        tags.append("dlpno")
    elif any(m in kw_line for m in ["ccsd", "cisd", "fci"]):
        tags.append("wf")
    elif "mp2" in kw_line:
        tags.append("mp2")
    elif "hf" in kw_line and not any(
        x in kw_line for x in ["b3lyp", "pbe", "tpss", "m06", "cam-b3lyp", "wb97"]
    ):
        tags.append("hf")

    return tags


class JobError(Exception):
    """Per-file failure; the file is skipped and qprep exits non-zero."""


def fit_nprocs_to_queue(
    input_file: Path,
    content: str,
    nprocs: int,
    queue: str,
    max_procs: int,
    upgrade_nprocs: bool,
    dry_run: bool,
    quiet: bool = False,
) -> tuple[str, int]:
    """Check nprocs against the queue limit; optionally rewrite the input up to it."""
    name = input_file.name
    if nprocs > max_procs:
        raise JobError(f"{nprocs} procs requested but queue '{queue}' allows at most {max_procs}")

    if nprocs < max_procs:
        if upgrade_nprocs:
            content = rewrite_nprocs_in_content(content, max_procs)
            if not dry_run:
                input_file.write_text(content)
            eprint(f"[{name}] upgraded nprocs {nprocs} -> {max_procs}")
            nprocs = max_procs
        elif not quiet:
            eprint(
                f"Warning [{name}]: {nprocs} procs, queue '{queue}' supports {max_procs} "
                f"(pass --upgrade-nprocs to rewrite the input)"
            )
    return content, nprocs


def queue_walltime(config: dict, queue: str) -> str:
    """Walltime a job in this queue requests: the queue's own, else the remote's."""
    return config["queues"][queue].get("walltime", config["walltime"])


def process_file(
    input_file: Path,
    remote: str,
    config: dict,
    queue: Optional[str],
    orca_version: Optional[str],
    use_dir_name: bool,
    upgrade_nprocs: bool,
    extra_tags: list[str],
    strategy: Optional[str],
    memory: Optional[int],
    dry_run: bool,
) -> None:
    if use_dir_name:
        current_dir = Path.cwd()
        job_name = f"{current_dir.parent.name}_{current_dir.name}"
    else:
        job_name = input_file.stem

    input_filename = input_file.name
    input_stem = input_file.stem
    content = input_file.read_text()

    nprocs = parse_orca_input(content)["nprocs"]
    if not nprocs:
        raise JobError("could not find PAL<n> or '%pal nprocs <n>' in input file")

    if remote == "jupiter":
        resolved_queue = queue or ("big" if nprocs == 16 else "small")
    else:
        resolved_queue = queue or config["default_queue"]

    queue_mem_gb = config["queues"][resolved_queue]["mem_gb"]
    if memory is not None and memory > queue_mem_gb:
        raise JobError(f"--memory {memory} exceeds queue '{resolved_queue}' maximum of {queue_mem_gb} GB")

    # --memory means the job was sized on purpose, so skip the below-max warning.
    content, nprocs = fit_nprocs_to_queue(
        input_file, content, nprocs, resolved_queue,
        config["queues"][resolved_queue]["max_procs"], upgrade_nprocs, dry_run,
        quiet=memory is not None,
    )
    # The queue's full memory unless --memory is given; %maxcore is ignored.
    memory_gb = memory if memory is not None else queue_mem_gb
    walltime = queue_walltime(config, resolved_queue)
    log = f"queue={resolved_queue} nprocs={nprocs} mem={memory_gb}gb walltime={walltime}"

    if remote == "jupiter":
        job_script_content = PBS_JUPITER_TEMPLATE.format(
            nprocs=nprocs,
            walltime=walltime,
            memory_gb=memory_gb,
            queue=resolved_queue,
            job_name=job_name,
            orca_path=config["orca_path"],
            input_filename=input_filename,
            input_stem=input_stem,
        )

    elif remote == "njup":
        version = orca_version or config["default_orca_version"]
        log += f" orca={version}"
        job_script_content = SLURM_NJUP_TEMPLATE.format(
            job_name=job_name,
            nprocs=nprocs,
            walltime=walltime,
            memory_gb=memory_gb,
            queue=resolved_queue,
            orca_module=config["orca_modules"][version],
            orca_version=version,
            orca_exec=config["orca_paths"][version],
            input_filename=input_filename,
            input_stem=input_stem,
        )

    else:  # pragma: no cover - guarded by click.Choice
        raise JobError(f"no job template for remote '{remote}'")

    job_script_path = Path(f"{job_name}{config['script_ext']}")
    if dry_run:
        eprint(f"[{input_filename}] {log} -> {job_script_path} (dry run, not written)")
        eprint(job_script_content)
    else:
        job_script_path.write_text(job_script_content)
        eprint(f"[{input_filename}] {log} -> {job_script_path}")

    tags = extract_orca_tags(content) + extra_tags
    cmd = ["recli", "submit", str(job_script_path), "-r", config["recli_remote"]]
    if strategy:
        cmd += ["--strategy", strategy]
    if tags:
        cmd += ["--tags"] + tags
    print(" ".join(cmd))


# --- CLI ---

VERSION_REMOTES = [r for r, c in CLUSTER_CONFIG.items() if "orca_paths" in c]
ORCA_VERSIONS = ["5", "6"]
STRATEGIES = ["basename", "script", "directory"]


def _remote_summary() -> str:
    """One line per remote, derived from CLUSTER_CONFIG, for --help."""
    lines = []
    for name, cfg in CLUSTER_CONFIG.items():
        q = ", ".join(
            f"{q}={c['max_procs']}p/{c['mem_gb']}gb"
            + (f"/{c['walltime']}" if "walltime" in c else "")
            for q, c in cfg["queues"].items()
        )
        q += f" (walltime {cfg['walltime']} unless shown)"
        extra = f"{cfg['scheduler']}; queues {q}"
        if "orca_paths" in cfg:
            extra += f"; ORCA {'/'.join(cfg['orca_paths'])} (default {cfg['default_orca_version']})"
        else:
            extra += f"; ORCA {Path(cfg['orca_path']).parent.name}"
        lines.append(f"  {name:<8} {cfg['script_ext']:<7} {extra}")
    return "\n".join(lines)


EPILOG = f"""\b
Remotes:
{_remote_summary()}

\b
Resource rules:
  - nprocs is read from '! PAL<n>' or '%pal nprocs <n>' (required).
  - jupiter: queue defaults to 'big' if nprocs == 16, else 'small'.
  - njup: queue defaults to 'cpu-big'.
  - nprocs above the queue limit is an error; below it is a warning unless
    --upgrade-nprocs (rewrites the .inp in place) or --memory is given.
  - Memory is the queue maximum unless --memory GB is given (it may not
    exceed the queue maximum); %maxcore in the input is ignored. Use
    --memory to share a node, e.g. two 8-proc jobs at 30 GB on njup cpu-big.
  - Walltime is the queue's (jupiter fast: 12h) or else the remote's; jobs
    that run past it are killed.

\b
Output:
  - Writes <job_name><ext> in the current directory (job_name = input stem,
    or <parent>_<cwd> with --use-dir-name).
  - stdout: one `recli submit ...` command per file, with tags derived from
    the ORCA keywords plus any --tags.
  - stderr: progress, warnings, errors.
  - Exit code 0 if every file succeeded, 1 if any failed, 2 on usage errors.
    Failing files are skipped; the rest are still processed.

\b
Examples:
  qprep -r jupiter opt.inp
  qprep -r jupiter -q freq --upgrade-nprocs freq.inp
  qprep -r njup --upgrade-nprocs *.inp | sh
  qprep -r njup --orca-version 5 sp.inp
  qprep -r njup --memory 30 *.inp | sh
  qprep -r jupiter --tags ts,guess2 --strategy directory ts.inp | sh
  qprep -r njup --dry-run sp.inp
"""


def _split_tags(ctx, param, values) -> list[str]:
    return [t.strip() for v in values for t in v.split(",") if t.strip()]


@click.command(
    epilog=EPILOG,
    context_settings={"help_option_names": ["-h", "--help"], "max_content_width": 100},
)
@click.argument(
    "input_files",
    nargs=-1,
    required=True,
    type=click.Path(exists=True, dir_okay=False, path_type=Path),
    metavar="INPUT.inp...",
)
@click.option(
    "-r", "--remote",
    required=True,
    type=click.Choice(list(CLUSTER_CONFIG)),
    help="Target cluster (see Remotes below).",
)
@click.option(
    "-q", "--queue",
    metavar="QUEUE",
    help="Queue/partition of the chosen remote (see Remotes). Default: per remote.",
)
@click.option(
    "--orca-version",
    type=click.Choice(ORCA_VERSIONS),
    help=f"ORCA major version ({'/'.join(VERSION_REMOTES)} only). Default: per remote.",
)
@click.option(
    "--upgrade-nprocs",
    is_flag=True,
    help="Rewrite PAL/nprocs in the .inp up to the queue maximum.",
)
@click.option(
    "--use-dir-name",
    is_flag=True,
    help="Name the job '<parent_dir>_<current_dir>' instead of the input stem (single file only).",
)
@click.option(
    "-t", "--tags",
    "extra_tags",
    multiple=True,
    callback=_split_tags,
    help="Extra recli tags; comma-separated and/or repeatable.",
)
@click.option(
    "--strategy",
    type=click.Choice(STRATEGIES),
    help="recli upload strategy. Default: recli's configured default.",
)
@click.option(
    "--memory",
    type=click.IntRange(min=1),
    metavar="GB",
    help="Memory to request, in GB (at most the queue maximum). Default: queue maximum.",
)
@click.option(
    "-n", "--dry-run",
    is_flag=True,
    help="Print job scripts to stderr instead of writing anything.",
)
def main(
    input_files: tuple[Path, ...],
    remote: str,
    queue: Optional[str],
    orca_version: Optional[str],
    upgrade_nprocs: bool,
    use_dir_name: bool,
    extra_tags: list[str],
    strategy: Optional[str],
    memory: Optional[int],
    dry_run: bool,
):
    """Generate ORCA job scripts for HPC clusters and print recli submit commands.

    Non-interactive: every choice comes from flags or the input file.
    """
    config = CLUSTER_CONFIG[remote]

    if queue and queue not in config["queues"]:
        raise click.UsageError(
            f"unknown queue '{queue}' for {remote}; choose from: {', '.join(config['queues'])}."
        )
    if orca_version and remote not in VERSION_REMOTES:
        raise click.UsageError(
            f"--orca-version only applies to {'/'.join(VERSION_REMOTES)}, not '{remote}'."
        )
    if use_dir_name and len(input_files) > 1:
        raise click.UsageError("--use-dir-name with multiple files would give every job the same name.")

    failed = 0
    for input_file in input_files:
        try:
            process_file(
                input_file, remote, config, queue, orca_version,
                use_dir_name, upgrade_nprocs, extra_tags, strategy, memory, dry_run,
            )
        except JobError as e:
            eprint(f"Error [{input_file.name}]: {e}")
            failed += 1

    if failed:
        eprint(f"{failed}/{len(input_files)} file(s) failed.")
        sys.exit(1)


if __name__ == "__main__":
    main()
