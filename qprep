module load {orca_module}

shopt -s extglob

JOB_ID=${{SLURM_JOB_ID}}
SUBMIT_DIR=${{SLURM_SUBMIT_DIR}}
TDIR=/rascunho/${{USER}}-${{JOB_ID}}
