cd "${{TDIR}}"

# Log metadata
echo "Start of job: $(date)" > "${{JOB_LOG}}"
echo "ORCA {orca_version}: {orca_exec}" >> "${{JOB_LOG}}"
echo "Running on: $(hostname) via ${{SLURM_SUBMIT_HOST}}" >> "${{JOB_LOG}}"
echo "Local scratch: ${{TDIR}}" >> "${{JOB_LOG}}"

# Stage files back on exit, including scancel/timeout (SIGTERM).
# The signal traps just exit, so cleanup runs exactly once via the EXIT trap.
SYNC_PID=""
cleanup() {{
    [ -n "${{SYNC_PID}}" ] && kill "${{SYNC_PID}}" 2>/dev/null
